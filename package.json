{
  "name": "whatis-site",
  "version": "1.0.0",
  "description": "WhatIs.site — Clear explanations of everything",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-llms-txt.mjs && node scripts/seo/verify-internal-links.mjs",
    "build": "astro build",
    "postbuild": "node scripts/seo/indexnow-submit.mjs --auto",
    "preview": "astro preview",
    "astro": "astro",
    "seo:report": "node scripts/seo/generate-monthly-report.mjs",
    "seo:spotcheck": "node scripts/seo/ai-overview-spotcheck.mjs",
    "seo:indexnow": "node scripts/seo/indexnow-submit.mjs --new-assets",
    "seo:indexnow:all": "node scripts/seo/indexnow-submit.mjs --all",
    "seo:indexnow:recent": "node scripts/seo/indexnow-submit.mjs --recent 7",
    "seo:verify": "node scripts/seo/verify-internal-links.mjs"
  },
  "keywords": [
    "education",
    "articles",
    "astro"
  ],
  "author": "Nick Lasky",
  "license": "ISC",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^9.0.4",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^5.18.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "googleapis": "^144.0.0"
  }
}
