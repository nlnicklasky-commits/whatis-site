---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://whatis.site';
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'WhatIs.site';
---

<BaseLayout
  title="About"
  description="WhatIs.site is an editorial reference site with 1,600+ articles plus statistics roundups and free tools. Here's our editorial standard, sourcing policy, and who's behind it."
  canonicalUrl={`${siteUrl}/about`}
>
  <!-- AboutPage schema referencing the sitewide Organization -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": `About ${siteName}`,
    "url": `${siteUrl}/about`,
    "mainEntity": { "@id": `${siteUrl}/#organization` }
  })} />

  <!-- Breadcrumb -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "About" }
    ]
  })} />

  <article class="max-w-3xl mx-auto px-4 py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-gray-500 mb-4">
      <ol class="flex items-center gap-1 flex-wrap">
        <li><a href="/" class="hover:text-blue-600 transition-colors">Home</a></li>
        <li class="before:content-['/'] before:mx-1.5 before:text-gray-300 text-gray-900">About</li>
      </ol>
    </nav>

    <header class="mb-8">
      <h1 class="font-heading text-4xl md:text-5xl font-bold text-gray-900 mb-3">About {siteName}</h1>
      <p class="text-lg text-gray-700 leading-relaxed">
        An editorial reference site explaining the concepts that shape the modern world — over 1,600 articles, plus
        curated statistics roundups and free tools.
      </p>
    </header>

    <div class="prose prose-lg max-w-none">
      <h2>What we publish</h2>
      <p>
        Three things, in order of volume:
      </p>
      <ul>
        <li><strong>Explainer articles</strong> — 1,600+ pieces across 25 categories, structured in three depth tiers (3,000–5,000 words for definitive coverage, 2,000–3,000 for thorough, 1,200–2,000 for clear overview). Every article opens with a clean definition, includes specific facts and named sources, and ends with frequently asked questions.</li>
        <li><strong><a href="/statistics">Statistics roundups</a></strong> — citation-ready aggregations of primary-source data, currently covering AI, remote work, cryptocurrency, mental health, and climate change. Updated quarterly.</li>
        <li><strong><a href="/free-tools">Free tools</a></strong> — single-purpose calculators and converters that pair with our explainers. All math runs in your browser; nothing leaves your device.</li>
      </ul>

      <h2>How we write</h2>
      <p>
        Our voice is informal and direct. We write the way a smart friend would explain something — specific, opinionated where it helps, and willing to call things out when conventional wisdom is wrong. We avoid corporate-blog vocabulary like "delve," "leverage," "robust," and "in today's landscape." We use "you" and "your." We use em-dashes and short sentences.
      </p>
      <p>
        Articles are written by editorial staff with subject-matter input from contributors. AI tools are used in drafting and research, but every article is reviewed by a human editor before publishing.
      </p>

      <h2>Editorial standards</h2>
      <p>
        We aggregate; we don't survey. Statistics come from primary publications (Stanford HAI, WHO, CDC, IPCC, IEA, the BLS, OECD, McKinsey, Pew, FRED, and similar). Every numeric claim in a statistics roundup links to its source. Where a source moves or breaks, we update the citation — and we capture archive.org snapshots at publish time as fallbacks.
      </p>
      <p>
        Articles include both <code>datePublished</code> and <code>dateModified</code> in the visible header and the structured data. Statistics pages display the "last fact-checked" date prominently. We refresh statistics pages on a quarterly cadence.
      </p>
      <p>
        For the long-form policy and source list, see our <a href="/methodology">methodology page</a>.
      </p>

      <h2>Corrections</h2>
      <p>
        Found a factual error? Email <a href="mailto:hello@whatis.site">hello@whatis.site</a> with the URL and what's wrong. We treat correction requests seriously and respond within a few business days. Corrections to statistics pages happen out-of-cycle; corrections to explainer articles are batched but always acknowledged.
      </p>

      <h2>What you won't find here</h2>
      <ul>
        <li>Affiliate-link-driven product reviews dressed up as explainers</li>
        <li>Sponsored content presented as editorial</li>
        <li>"What is X" pages that exist only to rank, with no actual definition or substance</li>
        <li>Cold outreach for backlinks (we don't do it, and we'd appreciate it if you didn't either)</li>
      </ul>

      <h2>Who runs this</h2>
      <p>
        {siteName} is independently owned and edited. Funding comes from display advertising and the affiliate revenue mix common to reference sites — disclosed when applicable. We are not affiliated with TechTarget's WhatIs.com or any other "what is" branded property.
      </p>

      <h2>Cite us</h2>
      <p>
        Citation snippets (APA and plain-text) are at the bottom of every statistics roundup. Standard academic-and-editorial use is welcomed without permission. For reuse beyond fair use — bulk republication, derivative datasets, training data — please email us first.
      </p>

      <h2>Contact</h2>
      <p>
        General: <a href="mailto:hello@whatis.site">hello@whatis.site</a><br />
        Corrections: include the URL and what's wrong<br />
        Press / collaboration: same address, mention "press" in subject
      </p>
    </div>
  </article>
</BaseLayout>
