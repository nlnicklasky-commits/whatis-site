---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://whatis.site';
const canonicalUrl = `${siteUrl}/statistics`;

const statsPages = [
  {
    title: 'Artificial Intelligence Statistics 2026',
    slug: 'artificial-intelligence-statistics-2026',
    blurb: 'Enterprise AI adoption, generative AI usage, investment, workforce impact, and regulation — sourced from Stanford HAI, McKinsey, Pew, and the OECD.',
    category: 'Technology',
    tag: '60+ stats',
  },
  {
    title: 'Remote Work Statistics 2026',
    slug: 'remote-work-statistics-2026',
    blurb: 'How many people work from home, what RTO mandates have actually done, productivity research, and the geographic split.',
    category: 'Business',
    tag: '50+ stats',
  },
  {
    title: 'Cryptocurrency Statistics 2026',
    slug: 'cryptocurrency-statistics-2026',
    blurb: 'Global ownership, market cap, Bitcoin ETF flows, adoption by country, illicit activity, and stablecoin volume.',
    category: 'Finance',
    tag: '40+ stats',
  },
  {
    title: 'Mental Health Statistics 2026',
    slug: 'mental-health-statistics-2026',
    blurb: 'Prevalence of mental illness, depression and anxiety rates, suicide data, treatment gaps, and youth mental health trends.',
    category: 'Health & Wellness',
    tag: '40+ stats',
  },
  {
    title: 'Climate Change Statistics 2026',
    slug: 'climate-change-statistics-2026',
    blurb: 'Temperature, CO₂ emissions, sea level, renewables, and disaster costs — sourced from IPCC, NASA, NOAA, and IEA.',
    category: 'Science',
    tag: '50+ stats',
  },
];
---

<BaseLayout
  title="Statistics — Curated Data Roundups"
  description="Curated 2026 statistics roundups on AI, remote work, cryptocurrency, mental health, and climate change. Every figure sourced from primary publications. Cite us."
  canonicalUrl={canonicalUrl}
  ogType="website"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": canonicalUrl,
    "name": "WhatIs.site Statistics",
    "url": canonicalUrl,
    "description": "Curated statistics roundups across technology, business, finance, health, and science.",
    "publisher": { "@id": `${siteUrl}/#organization` },
    "hasPart": statsPages.map(p => ({
      "@type": "Article",
      "name": p.title,
      "url": `${siteUrl}/${p.slug}`,
      "description": p.blurb
    }))
  })} />

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "Statistics" }
    ]
  })} />

  <div class="max-w-5xl mx-auto px-4 py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-gray-500 mb-4">
      <ol class="flex items-center gap-1 flex-wrap">
        <li><a href="/" class="hover:text-blue-600 transition-colors">Home</a></li>
        <li class="before:content-['/'] before:mx-1.5 before:text-gray-300 text-gray-900">Statistics</li>
      </ol>
    </nav>

    <header class="mb-10">
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-gray-900 mb-3">Statistics</h1>
      <p class="text-lg text-gray-700 leading-relaxed max-w-3xl">
        Curated, citation-ready statistics roundups across the topics we cover. Every number is sourced
        from a primary publication. We update each page quarterly. <strong>Journalists and bloggers welcome</strong> —
        copy-paste citation snippets are at the bottom of each page.
      </p>
    </header>

    <section class="mb-12">
      <h2 class="text-xl font-heading font-semibold text-gray-900 mb-5">2026 roundups</h2>
      <div class="grid gap-5 md:grid-cols-2">
        {statsPages.map(p => (
          <a href={`/${p.slug}`} class="block group border border-gray-200 rounded-lg p-6 hover:border-blue-500 hover:shadow-md transition-all bg-white">
            <div class="flex items-center justify-between mb-3 text-xs">
              <span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded font-medium">{p.category}</span>
              <span class="text-gray-500">{p.tag}</span>
            </div>
            <h3 class="text-lg font-heading font-semibold text-gray-900 group-hover:text-blue-700 mb-2">{p.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{p.blurb}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mb-12 bg-gray-50 border border-gray-200 rounded-lg p-6">
      <h2 class="text-xl font-heading font-semibold text-gray-900 mb-3">How we source these</h2>
      <p class="text-gray-700 leading-relaxed mb-3">
        We aggregate; we do not survey. Every figure on every page links to a primary publication —
        Stanford AI Index, WHO, CDC, IEA, McKinsey, Pew, IPCC, and similar. Methodology is documented at the
        bottom of each page along with the date each fact was checked.
      </p>
      <p class="text-gray-700 leading-relaxed">
        If you spot a stat that needs updating, <a href="/about" class="text-blue-700 hover:underline">let us know</a>.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-heading font-semibold text-gray-900 mb-3">Cite our roundups</h2>
      <p class="text-gray-700 mb-3">
        Each page includes APA and plain-text citation snippets. Copy and paste — no permission required for educational or editorial use.
        Attribution is appreciated.
      </p>
      <p class="text-sm text-gray-600">
        Looking for tools instead? Try our free <a href="/free-tools" class="text-blue-700 hover:underline">calculators and converters</a>.
      </p>
    </section>
  </div>
</BaseLayout>
